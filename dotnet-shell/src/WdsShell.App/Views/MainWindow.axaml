<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WdsShell.App.ViewModels"
        xmlns:controls="clr-namespace:WdsShell.App.Controls"
        x:Class="WdsShell.App.Views.MainWindow"
        Width="1240" Height="800"
        MinWidth="800" MinHeight="500"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        Background="Transparent"
        Title="WDS Shell — 磁盘空间可视化 (Preview)">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <DockPanel>

    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource SystemBaseLowColor}">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                    Width="230" IsEnabled="{Binding !IsScanning}" />
          <Button Content="扫描" Command="{Binding ScanCommand}" IsEnabled="{Binding !IsScanning}" />
          <Button Content="停止" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}" />
          <Button Content="⬆ 上一级" Command="{Binding NavigateUpCommand}" />
          <ProgressBar IsIndeterminate="{Binding IsScanning}" Width="120" Height="8"
                       VerticalAlignment="Center" IsVisible="{Binding IsScanning}" />
        </StackPanel>
        <TextBlock Text="{Binding Breadcrumb}" FontSize="12" Opacity="0.8"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- 底部状态栏：去掉硬编码的 #1B1B1F 深色背景（浅色主题下会黑底黑字看不清），
         改为继承主题前景色 + 透明背景（透出 Mica），与顶部工具栏同一机制，两种主题下文字均清晰。 -->
    <Border DockPanel.Dock="Bottom" Padding="10,4"
            BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.9" />
    </Border>

    <!-- 主区域：左列表 | 分割条 | 右可视化 -->
    <Grid ColumnDefinitions="420,Auto,*">

      <ListBox Grid.Column="0" x:Name="FileList"
               ItemsSource="{Binding Rows}"
               SelectionMode="Single"
               DoubleTapped="OnFileListDoubleTapped"
               Padding="4">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2"
                         Fill="{Binding Brush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Width="200" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SizeText}" Width="86" TextAlignment="Right" Opacity="0.9" />
              <TextBlock Text="{Binding PercentText}" Width="48" TextAlignment="Right" Opacity="0.7" />
              <TextBlock Text="{Binding MetaText}" Opacity="0.55" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Column="1" Width="4" />

      <Grid Grid.Column="2" RowDefinitions="22,*">
        <controls:ExtensionBarControl Grid.Row="0" x:Name="ExtensionBar"
                                      Segments="{Binding ExtensionSegments}" />
        <controls:TreemapControl Grid.Row="1" x:Name="Treemap"
                                 Tiles="{Binding TreemapTiles}" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
