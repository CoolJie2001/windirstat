<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WdsShell.App.Views.SettingsWindow"
        Width="660" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        TransparencyLevelHint="Mica, AcrylicBlur, Transparent"
        Background="Transparent"
        Icon="avares://DiskScope/Assets/app.ico"
        Title="设置">

  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.note">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.72" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Bottom" Padding="12,8"
            Background="{DynamicResource ChromeBrush}"
            BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*">
        <Button Grid.Column="0" Content="恢复默认" Click="OnReset" />
        <TextBlock Grid.Column="1" Classes="note" Margin="12,0,0,0" VerticalAlignment="Center"
                   Text="改动即时生效，关闭即保存。上游是 OK / Cancel / Apply 三键的模态属性表，这里刻意简化成实时应用。" />
      </Grid>
    </Border>

    <TabControl Margin="10">

      <!-- ===================== 外观（对应上游"常规"页） ===================== -->
      <TabItem Header="外观">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="2,4">
            <Border Classes="card">
              <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Classes="h" Text="主题" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ThemeBox"
                          HorizontalAlignment="Left" MinWidth="180" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="h" Text="窗口背景材质" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="BackdropBox"
                          HorizontalAlignment="Left" MinWidth="180" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="h" Text="左侧面板宽度 (DIP)" VerticalAlignment="Center" />
                <Slider Grid.Row="2" Grid.Column="1" Width="260" HorizontalAlignment="Left"
                        Minimum="380" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding LeftPaneWidth, Mode=TwoWay}" />
              </Grid>
            </Border>
            <TextBlock Classes="note" Margin="2,0"
                       Text="主题对应上游 Options\DarkMode（默认跟随系统）。材质对应 shell 自有的一层：上游是 Win32 原生标题栏，没有材质这一层；Windows 11 上走 DWM 的 DWMWA_SYSTEMBACKDROP_TYPE（Mica / Desktop Acrylic），更早的系统退回 Avalonia 的旧入口，系统不支持时自动回退。本设置即时作用于全部窗口，包括这个设置窗口。面板宽度对应上游的分割条比例。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== 目录树（对应上游"文件夹列表"页） ===================== -->
      <TabItem Header="目录树">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="2,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h" Text="可选列" />
                <CheckBox Content="百分比" IsChecked="{Binding ShowPercentage, Mode=TwoWay}" />
                <CheckBox Content="大小（物理）" IsChecked="{Binding ShowSizePhysical, Mode=TwoWay}" />
                <CheckBox Content="大小（逻辑）" IsChecked="{Binding ShowSizeLogical, Mode=TwoWay}" />
                <CheckBox Content="文件" IsChecked="{Binding ShowFiles, Mode=TwoWay}" />
                <CheckBox Content="文件夹" IsChecked="{Binding ShowFolders, Mode=TwoWay}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="note" Margin="2,0"
                       Text="默认勾选状态照抄上游 FileTreeColumnVisibility；“名称”与“占比”是上游的强制列，不提供开关。上游另有 项目数 / 最后修改 / 属性 / 所有者 四列，本 shell 的托管引擎尚未采集这些字段，故暂不列出。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== 区块图（对应上游"区块图"页） ===================== -->
      <TabItem Header="区块图">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="2,4">
            <Border Classes="card">
              <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="10">
                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                          Content="显示 &lt;Free Space&gt; 伪节点（下次扫描生效）"
                          IsChecked="{Binding ShowFreeSpace, Mode=TwoWay}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Classes="h" Text="递归深度" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                               Minimum="1" Maximum="6" Width="140"
                               Value="{Binding TreemapMaxDepth, Mode=TwoWay}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Classes="h" Text="每层子块上限" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                               Minimum="4" Maximum="64" Width="140"
                               Value="{Binding TreemapChildrenCap, Mode=TwoWay}" />
              </Grid>
            </Border>
            <TextBlock Classes="note" Margin="2,0"
                       Text="后两项是脚手架的性能钳制，上游没有对应设置：上游一次性把整棵扫描树递归铺进区块图。调大更精细但扫描期更吃帧，调小更流畅。等“全局一次成型 + 命中索引”那一步做完，这两个钳制会整体移除。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===================== 扫描（对应上游"高级"页的排除项） ===================== -->
      <TabItem Header="扫描">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="2,4">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h" Text="文件排除项（下次扫描生效）" />
                <CheckBox Content="排除隐藏文件" IsChecked="{Binding ExcludeHiddenFile, Mode=TwoWay}" />
                <CheckBox Content="排除受保护的操作系统文件" IsChecked="{Binding ExcludeProtectedFile, Mode=TwoWay}" />
                <CheckBox Content="不进入目录联接与符号链接" IsChecked="{Binding ExcludeLinkedDirectories, Mode=TwoWay}" />
                <Grid ColumnDefinitions="200,*" ColumnSpacing="10" Margin="0,6,0,0">
                  <TextBlock Grid.Column="0" Classes="h" Text="扫描线程数" VerticalAlignment="Center" />
                  <NumericUpDown Grid.Column="1" HorizontalAlignment="Left"
                                 Minimum="1" Maximum="16" Width="140"
                                 Value="{Binding ScanningThreads, Mode=TwoWay}" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Classes="note" Margin="2,0"
                       Text="键名与默认值对齐上游 Options.h：ExcludeHiddenFile / ExcludeProtectedFile 默认关（隐藏文件照常计入），ExcludeJunctions 默认开（防环），ScanningThreads 默认 4、范围 1–16。当前只有托管引擎读取这些选项，wdscore.dll 落地后经 ABI 一并下发。" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
