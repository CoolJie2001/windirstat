<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WdsShell.App</RootNamespace>
    <AssemblyName>DiskScope</AssemblyName>
    <Product>DiskScope</Product>
    <Title>DiskScope - Windows Disk Space Analyzer</Title>
    <Description>Windows disk space analyzer with treemap visualization and cleanup tools.</Description>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 资源管理器 / 快捷方式看的 exe 图标，由 tools/make_icon.py 生成（16..256 共 11 档）。
         SDK 把它转成 csc 的 /win32icon；不设这项时 .NET 会嵌一张默认蓝色窗口图。 -->
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 运行中标题栏与任务栏的图标走 avares://，必须显式声明为 AvaloniaResource：
         Avalonia 的 targets 只自动收 *.axaml，不会替你嵌 Assets 下的二进制资源。
         只列 app.ico，母图 app-master.png 是给人核对用的，不进包。 -->
    <AvaloniaResource Include="Assets/app.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.5" />
    <!-- 11.2.0 起 TreeDataGrid 转为商业授权（构建期强制校验 <AvaloniaUILicenseKey />，否则 AVLIC0001 直接失败）。
         11.1.1 是最后一个免密钥版本，与 Avalonia 11.3 运行时兼容；若日后拿到社区/商业密钥，改回 11.3.x 即可。 -->
    <PackageReference Include="Avalonia.Controls.TreeDataGrid" Version="11.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.5" />
    <!-- Avalonia.FreeDesktop 11.3.5 brings in 0.21.2, which is flagged by NU1903. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WdsShell.Core\WdsShell.Core.csproj" />
    <ProjectReference Include="..\WdsShell.Interop\WdsShell.Interop.csproj" />
  </ItemGroup>
</Project>
